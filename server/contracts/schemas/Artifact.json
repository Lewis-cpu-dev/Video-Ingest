{
  "additionalProperties": true,
  "properties": {
    "artifact_id": {
      "title": "Artifact Id",
      "type": "string"
    },
    "kind": {
      "enum": [
        "video",
        "audio",
        "transcript",
        "frame",
        "visual_index",
        "clip"
      ],
      "title": "Kind",
      "type": "string"
    },
    "status": {
      "enum": [
        "missing",
        "processing",
        "ready",
        "failed",
        "expired"
      ],
      "title": "Status",
      "type": "string"
    },
    "mime_type": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Mime Type"
    },
    "size_bytes": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Size Bytes"
    },
    "sha256": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sha256"
    },
    "expires_at": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expires At"
    }
  },
  "required": [
    "artifact_id",
    "kind",
    "status"
  ],
  "title": "Artifact",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://video-ingest.invalid/schemas/1.0/Artifact.json"
}
