{
  "$defs": {
    "PrepareRequest": {
      "additionalProperties": false,
      "properties": {
        "need": {
          "items": {
            "enum": [
              "transcript",
              "visual_index",
              "audio",
              "video",
              "clip"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Need",
          "type": "array"
        },
        "time_range": {
          "anyOf": [
            {
              "$ref": "#/$defs/TimeRange"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "language": {
          "anyOf": [
            {
              "maxLength": 32,
              "pattern": "^[a-zA-Z0-9_-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Language"
        },
        "quality": {
          "default": "overview",
          "enum": [
            "overview",
            "detail"
          ],
          "title": "Quality",
          "type": "string"
        }
      },
      "required": [
        "need"
      ],
      "title": "PrepareRequest",
      "type": "object"
    },
    "TimeRange": {
      "additionalProperties": false,
      "properties": {
        "start_ms": {
          "default": 0,
          "minimum": 0,
          "title": "Start Ms",
          "type": "integer"
        },
        "end_ms": {
          "exclusiveMinimum": 0,
          "title": "End Ms",
          "type": "integer"
        }
      },
      "required": [
        "end_ms"
      ],
      "title": "TimeRange",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "job_id": {
      "title": "Job Id",
      "type": "string"
    },
    "asset_id": {
      "title": "Asset Id",
      "type": "string"
    },
    "status": {
      "enum": [
        "queued",
        "running",
        "succeeded",
        "partial",
        "failed",
        "cancel_requested",
        "cancelled"
      ],
      "title": "Status",
      "type": "string"
    },
    "stage": {
      "enum": [
        "resolving",
        "fetching_captions",
        "downloading",
        "transcribing",
        "sampling",
        "validating"
      ],
      "title": "Stage",
      "type": "string"
    },
    "requested": {
      "$ref": "#/$defs/PrepareRequest"
    },
    "progress": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Progress"
    },
    "errors": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Errors",
      "type": "array"
    },
    "completed_outputs": {
      "items": {
        "type": "string"
      },
      "title": "Completed Outputs",
      "type": "array"
    },
    "available_artifacts": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Available Artifacts",
      "type": "array"
    },
    "usage": {
      "additionalProperties": true,
      "title": "Usage",
      "type": "object"
    },
    "next_poll_after_ms": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Next Poll After Ms"
    }
  },
  "required": [
    "job_id",
    "asset_id",
    "status",
    "stage",
    "requested"
  ],
  "title": "Job",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://video-ingest.invalid/schemas/1.0/Job.json"
}
